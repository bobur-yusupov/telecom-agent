# Postgres — also used to build DATABASE_URL inside docker-compose.yml
POSTGRES_USER=mirzo
POSTGRES_PASSWORD=mirzo
POSTGRES_DB=mirzo
POSTGRES_PORT=5432

# Admin panel — named ADMIN_PORT, not PORT: `mastra dev`'s own server also
# reads plain PORT, and would collide with this on the same port otherwise.
ADMIN_PORT=3001

# Model provider (SPEC.md §3.2)
DEEPSEEK_API_KEY=

# Telegram bot (SPEC.md §14, MASTRA.md §8)
TELEGRAM_BOT_TOKEN=
