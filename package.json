{
  "name": "telecom-agent",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npx mastra dev & tsx watch src/index.ts",
    "start": "npx mastra dev & tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src",
    "eval": "vitest run",
    "eval:watch": "vitest",
    "eval:ci": "./scripts/eval.sh",
    "gen:dataset": "./scripts/gen-dataset.sh",
    "db:reset": "tsx scripts/reset-db.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.74",
    "@mastra/libsql": "^1.10.1",
    "@mastra/memory": "^1.18.0",
    "@mastra/pg": "^1.11.0",
    "@types/pg": "^8.20.0",
    "ai": "^6.0.184",
    "dotenv": "^16.4.7",
    "mastra": "^1.9.1",
    "pg": "^8.20.0",
    "telegraf": "^4.16.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@mastra/evals": "^1.2.2",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.6"
  }
}
