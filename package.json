{
  "name": "telecom-agent",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npx mastra dev & tsx watch src/index.ts",
    "start": "npx mastra dev & tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src",
    "eval": "vitest run",
    "eval:watch": "vitest",
    "eval:ci": "./scripts/eval.sh",
    "eval:ci:gemini": "MODEL_PROVIDER=gemini ./scripts/eval.sh",
    "eval:ci:openai": "MODEL_PROVIDER=openai ./scripts/eval.sh",
    "eval:ci:deepseek": "MODEL_PROVIDER=deepseek ./scripts/eval.sh",
    "eval:ci:anthropic": "MODEL_PROVIDER=anthropic ./scripts/eval.sh",
    "gen:dataset": "./scripts/gen-dataset.sh",
    "gen:dataset:gemini": "MODEL_PROVIDER=gemini ./scripts/gen-dataset.sh",
    "gen:dataset:openai": "MODEL_PROVIDER=openai ./scripts/gen-dataset.sh",
    "gen:dataset:deepseek": "MODEL_PROVIDER=deepseek ./scripts/gen-dataset.sh",
    "gen:dataset:anthropic": "MODEL_PROVIDER=anthropic ./scripts/gen-dataset.sh",
    "db:reset": "tsx scripts/reset-db.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.98",
    "@ai-sdk/deepseek": "^2.0.50",
    "@ai-sdk/google": "^3.0.95",
    "@ai-sdk/openai": "^3.0.86",
    "@mastra/core": "^1.51.0",
    "@mastra/libsql": "^1.16.0",
    "@mastra/memory": "^1.23.0",
    "@mastra/pg": "^1.16.0",
    "@types/pg": "^8.20.0",
    "ai": "^6.0.230",
    "dotenv": "^16.6.1",
    "mastra": "^1.19.0",
    "pg": "^8.22.0",
    "telegraf": "^4.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@mastra/evals": "^1.5.1",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.6"
  }
}
