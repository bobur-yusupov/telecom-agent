TELEGRAM_TOKEN=your_telegram_bot_token_here

# Model under test — flip MODEL_PROVIDER to run Mirzo (live bot + evals) on a
# different provider. MODEL_NAME is optional; each provider has a sane default
# (see src/agents/provider.ts) if unset. The eval-scorer judge always stays on
# Gemini regardless of this flag, so scores stay comparable across providers.
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-3.1-flash-lite
GOOGLE_API_KEY=your_google_ai_studio_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

EMBEDDING_MODEL=nomic-embed-text
OLLAMA_HOST=http://localhost:11434
LOG_LEVEL=info

# Postgres / pgvector — defaults match docker-compose.yml
PGHOST=localhost
PGPORT=5432
PGUSER=mirzo
PGPASSWORD=mirzo
PGDATABASE=mirzo
